node_modules/
*.backup.*
*.tmp
.DS_Store
data/

# 用户本地配置：勿入库，避免更新冲突
config/config.yaml
config/config.yaml.bak

# 鸣潮角色立绘图库：体积过大（数百 MB），不入库，用户自备
resources/ww_role_pile/

# 过码服务（放在 solver 分支）：一键部署会拉到本地，但不该提交进 master
/service/

# 框架在本目录下写的运行时日志
logs/

# 本地 AI 工具的工作目录（含 worktree 残留，体积大）
.claude/

# 模块文件由管理器安装，不进入核心仓库
/apps/*
!/apps/help.js
!/apps/manage.js
/utils/*
!/utils/moduleManager.js
!/utils/moduleOptional.js
!/utils/moduleStore.js
!/utils/modules.js
!/utils/pluginConfig.js
!/utils/render.js
!/utils/renderImage.js
!/utils/replyHelper.js
/resources/*
!/resources/help/
!/resources/icon.png

!/utils/delivery.js

!/utils/taskLifecycle.js
